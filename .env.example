# Supabase Configuration
# Replace these with your project's URL and Anon Key from your Supabase Dashboard (Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# App Domain (your production domain)
VITE_APP_URL=https://www.hendrixbrokerhub.in

# Razorpay (Public Key ID - safe to expose on frontend)
# Get this from Razorpay Dashboard > Settings > API Keys
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
